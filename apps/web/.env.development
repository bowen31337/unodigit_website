# `pnpm dev` configuration for the BA bot widget. Same public values as
# .env.production — see that file for why they are committed rather than secret.
#
# The Worker's CORS allowlist (ALLOWED_ORIGIN in apps/ba-bot-api/wrangler.toml)
# includes http://localhost:3000, so the deployed Worker accepts calls straight
# from `pnpm dev`. To develop against a local Worker instead, run
# `pnpm bot:dev` and change this to http://localhost:8787.
NEXT_PUBLIC_BA_BOT_URL=https://api.claw-forge.net
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAET8RNKDwLGdBrG-
