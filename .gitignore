# Dependencies
node_modules
.pnpm-store

# Next.js
.next
out

# Production
build
dist

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ...but the two BA-bot widget env files MUST be committed. They hold only
# NEXT_PUBLIC_* values, which Next inlines into the client bundle and serves to
# every visitor — public by construction, not secrets. CI builds the static
# export straight from a checkout, so if these are ignored the deployed site
# silently ships with no widget at all.
#
# These negations are load-bearing: a global ignore file (~/.gitignore_global)
# may carry a broad `.env*` pattern, and repository .gitignore rules are applied
# after it, so this is what re-includes them.
!apps/web/.env.production
!apps/web/.env.development

# Vercel
.vercel

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
*.pem

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Claude Code worktrees
.claude/worktrees/

# Superpowers SDD workspace (scratch: ledger, briefs, review packages)
.superpowers/

# UI before/after captures. Kept locally while working on a change and shared
# by hand — they are large binaries that date fast, and the repo is not where
# they earn their keep.
docs/screenshots/

# Turborepo local task cache (root and per-package)
.turbo/

# Wrangler local state / secrets (belt and braces with apps/ba-bot-api/.gitignore —
# `pnpm wrangler ...` run one directory too high creates these at the repo root)
.wrangler/
.dev.vars
.dev.vars.*

# Any dot-cache directory, at any depth. The one that prompted this was
# tools/fonts/.cache/ — the upstream archives fetched by build-fonts.py (Inter
# ~34 MB plus its full extraction, and JetBrains Mono) which measured 109 MB and
# were one `git add -A` away from entering history. They are regenerable: the
# pinned URLs and their SHA-256 live in that script.
#
# Deliberately `.cache/` and NOT a bare `cache/`: the latter would also swallow a
# legitimate source directory named `cache`, which is a silent and very
# confusing way to lose code.
.cache/

# Python — tools/fonts/ is a Python toolchain (fontTools, skia-pathops).
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Test output. The Worker's Vitest suite writes coverage/ under --coverage;
# nothing here is an input to anything.
coverage/
*.lcov
.vitest/

# Browser automation artefacts. Playwright and browser-harness both drop
# screenshot/trace directories wherever they are invoked from — they are large,
# they date immediately, and they are captured to be looked at once.
test-results/
playwright-report/
blob-report/
playwright/.cache/
.playwright-mcp/
.browser_screenshots/

# Lint/build caches
.eslintcache
*.tsbuildinfo

# Logs and scratch files, beyond the package-manager debug logs above
*.log
*.tmp
.tmp/

# OS cruft not already covered
Thumbs.db
desktop.ini
._*
.Spotlight-V100
.Trashes
