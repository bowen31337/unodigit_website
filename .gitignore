# Dependencies
node_modules
.pnpm-store

# Next.js
.next
out

# Production
build
dist

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# ...but the two BA-bot widget env files MUST be committed. They hold only
# NEXT_PUBLIC_* values, which Next inlines into the client bundle and serves to
# every visitor — public by construction, not secrets. CI builds the static
# export straight from a checkout, so if these are ignored the deployed site
# silently ships with no widget at all.
#
# These negations are load-bearing: a global ignore file (~/.gitignore_global)
# may carry a broad `.env*` pattern, and repository .gitignore rules are applied
# after it, so this is what re-includes them.
!apps/web/.env.production
!apps/web/.env.development

# Vercel
.vercel

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store
*.pem

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Claude Code worktrees
.claude/worktrees/

# Superpowers SDD workspace (scratch: ledger, briefs, review packages)
.superpowers/

# Turborepo local task cache (root and per-package)
.turbo/

# Wrangler local state / secrets (belt and braces with apps/ba-bot-api/.gitignore —
# `pnpm wrangler ...` run one directory too high creates these at the repo root)
.wrangler/
.dev.vars
.dev.vars.*
